---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — Oribos"
  description="The page you are looking for does not exist."
  noindex
  pagefindIgnore
>
  <main id="main" class="not-found">
    <div class="not-found__inner">
      <p class="not-found__kicker">404</p>
      <h1 class="not-found__title">Page not found</h1>
      <p class="not-found__message">The page you are looking for does not exist.</p>
      <nav class="not-found__links" aria-label="Site">
        <a href="/">Home</a>
        <a href="/docs/">Docs</a>
        <a href="/templates/">Templates</a>
      </nav>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 100dvh;
    padding: var(--space-64) var(--gutter);
    background-color: var(--surface-0);
    place-items: center;
  }

  .not-found__inner {
    width: 100%;
    max-width: 72ch;
    padding-block-start: var(--space-32);
    border-block-start: 1px solid var(--border-hairline);
  }

  .not-found__kicker {
    margin: 0 0 var(--space-16);
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    font-weight: var(--font-weight-normal);
    line-height: var(--text-mono-sm--line-height);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }

  .not-found__title {
    margin: 0 0 var(--space-16);
    color: var(--text-1);
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--text-3xl--line-height);
    letter-spacing: var(--tracking-heading);
  }

  .not-found__message {
    max-width: 72ch;
    margin: 0;
    color: var(--text-2);
    font-size: var(--text-base);
    line-height: var(--text-base--line-height);
  }

  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-24);
    margin-block-start: var(--space-24);
  }

  .not-found__links a {
    color: var(--accent-text);
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    line-height: var(--text-base--line-height);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .not-found__links a:hover {
    text-decoration-thickness: 2px;
  }
</style>
