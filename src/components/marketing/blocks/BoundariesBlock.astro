---
import BlockHeading from '@/components/marketing/BlockHeading.astro';
import type { BoundariesBlock } from '@/lib/blocks';
import { renderMarkdown } from '@/lib/markdown';

interface Props {
  block: BoundariesBlock;
}

const { block } = Astro.props;
---

<section class="boundaries" data-block="boundaries">
  <BlockHeading heading={block.heading} intro={block.intro} />
  <ul class="boundaries__grid">
    {
      block.items.map((item) => (
        <li class="boundary" data-boundary>
          <h3 class="boundary__title">{item.title}</h3>
          <div class="boundary__body prose" set:html={renderMarkdown(item.body)} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .boundaries__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-16);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .boundary {
    padding: var(--space-24);
    border: 1px solid var(--border-hairline);
    background-color: var(--surface-0);
  }

  .boundary__title {
    margin: 0 0 var(--space-12);
    color: var(--text-1);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    line-height: var(--text-lg--line-height);
    letter-spacing: var(--tracking-heading);
  }

  .boundary__body {
    color: var(--text-2);
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
  }

  @media (max-width: 1023px) {
    .boundaries__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .boundaries__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
