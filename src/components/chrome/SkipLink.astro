<a class="skip-link" href="#main">Skip to content</a>

<style>
  .skip-link {
    position: fixed;
    inset-block-start: var(--space-8);
    inset-inline-start: var(--space-8);
    z-index: var(--z-skip);
    padding: var(--space-8) var(--space-12);
    border: 1px solid var(--border-strong);
