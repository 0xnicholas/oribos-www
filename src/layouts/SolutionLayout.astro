---
import type { CollectionEntry } from 'astro:content';

import BlockRenderer from '@/components/marketing/BlockRenderer.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/prose.css';

interface Props {
  entry: CollectionEntry<'marketing'>;
}

const { entry } = Astro.props;
const { data } = entry;
const title = data.seo.title ?? data.title;
const description = data.seo.description ?? data.description;
---

<BaseLayout title={title} description={description} noindex={data.seo.noindex}>
  <main id="main" class="solution-page">
    <header class="solution-page__hero" data-solution-hero>
      <div class="solution-page__container">
        {data.eyebrow && <p class="solution-page__eyebrow">{data.eyebrow}</p>}
        <h1 class="solution-page__title">{data.h1}</h1>
        {data.positioning && <p class="solution-page__positioning">{data.positioning}</p>}
      </div>
    </header>
    <div class="solution-page__container solution-page__sections">
      {data.sections.map((block) => <BlockRenderer block={block} />)}
    </div>
  </main>
</BaseLayout>

<style>
  .solution-page {
    padding-block-end: var(--space-96);
    background-color: var(--surface-0);
  }

  .solution-page__container {
    max-inline-size: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .solution-page__hero {
    padding: var(--hero-y);
    border-block-end: 1px solid var(--border-hairline);
    background-color: var(--surface-1);
  }

  .solution-page__eyebrow {
    margin: 0 0 var(--space-16);
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    line-height: var(--text-mono-sm--line-height);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .solution-page__title {
    margin: 0;
    color: var(--text-1);
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--text-4xl--line-height);
    letter-spacing: var(--tracking-heading);
  }

  .solution-page__positioning {
    max-inline-size: 44ch;
    margin: var(--space-24) 0 0;
    color: var(--text-2);
    font-size: var(--text-lg);
    line-height: var(--text-lg--line-height);
  }

  .solution-page__sections {
    display: grid;
    gap: var(--section-y);
    padding-block-start: var(--section-y);
  }

  .solution-page__sections > :global(*) {
    min-inline-size: 0;
  }

  @media (max-width: 767px) {
    .solution-page__title {
      font-size: var(--text-3xl);
      line-height: var(--text-3xl--line-height);
    }
  }
</style>
